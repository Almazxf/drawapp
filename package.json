{
  "name": "drawapp",
  "version": "1.0.0",
  "description": "Vector drawing app for USB flash drive",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.drawapp.portable",
    "productName": "DrawApp",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "DrawApp-portable.exe"
    }
  }
}
