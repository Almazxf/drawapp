{
  "name": "drawapp",
  "version": "1.0.0",
  "description": "Vector drawing app for USB flash drive",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis-web --config.nsis.oneClick=false --config.win.target=portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.drawapp.portable",
    "productName": "DrawApp",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "DrawApp-portable.exe"
    }
  }
}
